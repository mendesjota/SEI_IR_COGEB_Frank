# Template das credenciais do SEI. Copie para .env e preencha.
# O .env nunca deve ser versionado.

# Base do SEI. O login em si acontece no SIP, cuja URL está fixa em
# sei/config.py — só preencha aqui se quiser sobrescrevê-la (precisa conter
# "login.php", caso contrário este valor é ignorado).
SEI_URL=https://sei.df.gov.br

# Usuário de login
SEI_USUARIO=

# Senha de login
SEI_SENHA=

# Órgão do combo da tela de login. Aceita a sigla visível (ex.: IPREV)
# ou o value do <option> (ex.: 26) — o código tenta as duas leituras.
SEI_Orgao=IPREV

# Senha de credencial: a que o SEI pede no modal ao entrar em processos
# com credencial de segurança. Costuma ser igual à de login.
SEI_SENHA_CREDENCIAL=

# --- Opcionais, controlam a execução ---

# true roda sem abrir janela do navegador (padrão: false)
HEADLESS=true

# Abas em paralelo. 4 é ~2,5x mais rápido que 1; acima disso o SEI engasga.
ABAS=4

# Para em N processos. Deixe vazio para varrer a fila inteira.
LIMITE=
